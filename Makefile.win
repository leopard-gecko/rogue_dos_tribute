# MSYS2 UCRT64 native Windows build (PDCursesMod VT only).
# Use the top-level Makefile: make, make original, make japanese, etc.
# PDCursesMod package: mingw-w64-ucrt-x86_64-pdcurses.
# Windows icon resource: mingw-w64-ucrt-x86_64-binutils (windres).
# make FILEDIR=saved-games stores data in the Windows Saved Games/Rogue folder.
CC = gcc
WINDRES ?= windres
MINGW_PREFIX ?= /ucrt64
PROG ?=
PROGRAM ?= $(if $(PROG),$(PROG),rogue)
DEFAULT_LANGUAGE ?= 0
FILEDIR ?=

# Resolve the actual Windows known folder at build time, including
# redirection. The absolute result is embedded in the EXE.
# Do not query/create folders when cleaning or packaging source files.
ifeq ($(strip $(FILEDIR)),saved-games)
ifneq ($(filter-out clean dist.src,$(if $(strip $(MAKECMDGOALS)),$(MAKECMDGOALS),all)),)
SAVED_GAMES_FILEDIR := $(shell powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./windows/windows-saved-games.ps1)
ifeq ($(strip $(SAVED_GAMES_FILEDIR)),)
$(error Cannot resolve Windows Saved Games; check PowerShell and windows/windows-saved-games.ps1)
endif
RESOLVED_FILEDIR := $(SAVED_GAMES_FILEDIR)
AUTO_PREPARE_FILEDIR := 1
endif
else
RESOLVED_FILEDIR := $(FILEDIR)
endif

ifneq ($(strip $(RESOLVED_FILEDIR)),)
SAVEFILE ?= $(RESOLVED_FILEDIR)/$(PROGRAM).save
SCOREFILE ?= $(RESOLVED_FILEDIR)/$(PROGRAM).scr
LOCKFILE ?= $(RESOLVED_FILEDIR)/$(PROGRAM).lck
else
SAVEFILE ?= $(PROGRAM).save
SCOREFILE ?= $(PROGRAM).scr
LOCKFILE ?= $(PROGRAM).lck
endif

# Shared with the macOS/Linux Makefile; native services are Windows-only.
include sources.mk
CFILES = $(ROGUE_COMMON_CFILES) $(ROGUE_WINDOWS_CFILES)
OBJS = $(CFILES:.c=.win.o)
ICON_OBJ = windows/rogue-icon.win.o
WIN_DISTNAME = rogue_dos_tribute_jec092_windows
WIN_DIST_PROGRAM = rogue-dos
WIN_DIST_ORIGINAL = $(WIN_DIST_PROGRAM)_original
# The two distributed executables share data paths. Preserve caller overrides,
# but derive defaults from the distributed program, not the regular make target.
WIN_DIST_SAVEFILE = $(if $(filter command line,$(origin SAVEFILE)),$(SAVEFILE),$(if $(strip $(RESOLVED_FILEDIR)),$(RESOLVED_FILEDIR)/$(WIN_DIST_PROGRAM).save,$(WIN_DIST_PROGRAM).save))
WIN_DIST_SCOREFILE = $(if $(filter command line,$(origin SCOREFILE)),$(SCOREFILE),$(if $(strip $(RESOLVED_FILEDIR)),$(RESOLVED_FILEDIR)/$(WIN_DIST_PROGRAM).scr,$(WIN_DIST_PROGRAM).scr))
WIN_DIST_LOCKFILE = $(if $(filter command line,$(origin LOCKFILE)),$(LOCKFILE),$(if $(strip $(RESOLVED_FILEDIR)),$(RESOLVED_FILEDIR)/$(WIN_DIST_PROGRAM).lck,$(WIN_DIST_PROGRAM).lck))
# Name of the top-level folder inside the distributed ZIP (not the ZIP name).
WIN_DISTDIR = Rogue DOS Tribute
HEADERS = $(ROGUE_COMMON_HEADERS) $(ROGUE_WINDOWS_HEADERS)
CFLAGS ?= -O2 -g -Wall -Wextra
DEFAULT_OPTION_CPPFLAGS ?=
USER_CPPFLAGS := $(CPPFLAGS)
# Quote -D strings as one shell word (paths with spaces are preserved).
shell_quote = '$(subst ','"'"',$(1))'
CPP_SAVEFILE = $(call shell_quote,"$(SAVEFILE)")
CPP_SCOREFILE = $(call shell_quote,"$(SCOREFILE)")
CPP_LOCKFILE = $(call shell_quote,"$(LOCKFILE)")
override CPPFLAGS := -DHAVE_CONFIG_H -DPDC_WIDE=1 -DPDC_FORCE_UTF8=1 \
                     -I$(MINGW_PREFIX)/include/pdcurses -I. \
                     -DDEFAULT_SAVEFILE=$(CPP_SAVEFILE) \
                     -DSCOREFILE=$(CPP_SCOREFILE) -DLOCKFILE=$(CPP_LOCKFILE) \
                     -DDEFAULT_LANGUAGE=$(DEFAULT_LANGUAGE) \
                     $(DEFAULT_OPTION_CPPFLAGS) $(USER_CPPFLAGS) $(EXTRA_CPPFLAGS)
ifeq ($(MASTER),1)
override CPPFLAGS += -DMASTER
endif
LDFLAGS ?=
LDLIBS = -lpdcurses_vt -lwinmm -luser32 -lgdi32 -lshell32 -lshlwapi -ladvapi32 -lcomdlg32

.PHONY: all clean japanese english original master wizard prepare-filedir dist.src dist.win
all: $(PROGRAM).exe
# Only the saved-games shorthand creates its directory automatically.
ifeq ($(AUTO_PREPARE_FILEDIR),1)
$(PROGRAM).exe: | prepare-filedir
endif
prepare-filedir:
ifeq ($(strip $(RESOLVED_FILEDIR)),)
	@echo "FILEDIR is unset; data files use the current directory."
else
ifeq ($(AUTO_PREPARE_FILEDIR),1)
	@powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./windows/windows-saved-games.ps1 -Create
else
	@mkdir -p "$$(cygpath -u "$(RESOLVED_FILEDIR)")"
endif
endif
%.win.o: %.c $(HEADERS)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
$(ICON_OBJ): windows/rogue-icon.rc windows/rogue.ico
	$(WINDRES) -I windows -i windows/rogue-icon.rc -O coff -o $@
$(PROGRAM).exe: $(OBJS) $(ICON_OBJ)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(ICON_OBJ) $(LDLIBS)
clean:
	rm -f $(OBJS) $(ICON_OBJ) $(PROGRAM).exe
# Do not delete save, score or lock files under any clean target.
japanese:
	$(MAKE) ROGUE_BUILD=windows clean
	$(MAKE) ROGUE_BUILD=windows all DEFAULT_LANGUAGE=1
english:
	$(MAKE) ROGUE_BUILD=windows clean
	$(MAKE) ROGUE_BUILD=windows all DEFAULT_LANGUAGE=2
# Rogue DOS Tribute already uses DOS-style defaults. "original" changes only
# the initial display language; it does not alter the game or color defaults.
original:
	$(MAKE) ROGUE_BUILD=windows clean
	$(MAKE) ROGUE_BUILD=windows all DEFAULT_LANGUAGE=$(if $(filter command line,$(origin DEFAULT_LANGUAGE)),$(DEFAULT_LANGUAGE),2)
master:
	$(MAKE) ROGUE_BUILD=windows clean
	$(MAKE) ROGUE_BUILD=windows all MASTER=1
wizard: master
# Share one manifest and packaging path with macOS and Linux.
dist.src:
	$(MAKE) ROGUE_BUILD=unix dist.src

# Windows binary distribution: both executables in ONE ZIP.
# As in Rogue 5.2 JEC, compile each edition from clean objects so their
# initial languages differ. The DOS settings are otherwise identical.
# Both builds use the same embedded save/score/lock filenames.
# The distribution names are fixed; ordinary make PROGRAM=/PROG= is unchanged.
# Requires MSYS2 UCRT64's zip command. Never package a renamed normal build.
dist.win:
	@command -v zip >/dev/null 2>&1 || { echo "dist.win requires zip: pacman -S --needed zip" >&2; exit 1; }
	@$(MAKE) ROGUE_BUILD=windows PROGRAM=$(WIN_DIST_PROGRAM) clean
	@$(MAKE) ROGUE_BUILD=windows PROGRAM=$(WIN_DIST_PROGRAM) all DEFAULT_LANGUAGE=0 \
	    SAVEFILE="$(WIN_DIST_SAVEFILE)" SCOREFILE="$(WIN_DIST_SCOREFILE)" LOCKFILE="$(WIN_DIST_LOCKFILE)"
	@$(MAKE) ROGUE_BUILD=windows PROGRAM=$(WIN_DIST_ORIGINAL) clean
	@$(MAKE) ROGUE_BUILD=windows PROGRAM=$(WIN_DIST_ORIGINAL) all DEFAULT_LANGUAGE=2 \
	    SAVEFILE="$(WIN_DIST_SAVEFILE)" SCOREFILE="$(WIN_DIST_SCOREFILE)" LOCKFILE="$(WIN_DIST_LOCKFILE)"
	@set -eu; \
	    stage=$$(mktemp -d "$${TMPDIR:-/tmp}/rogue-dos-tribute-win.XXXXXXXX"); \
	    trap 'rm -rf "$$stage"' 0; \
	    trap 'exit 1' 1 2 3 15; \
	    mkdir -p "$$stage/$(WIN_DISTDIR)"; \
	    cp "$(WIN_DIST_PROGRAM).exe" "$(WIN_DIST_ORIGINAL).exe" "$$stage/$(WIN_DISTDIR)/"; \
	    cp LICENSE.TXT README_windows_ja.md README_windows_en.md \
	       rogue_ja.txt rogue_en.txt rogue_ja.html rogue_en.html \
	       "$$stage/$(WIN_DISTDIR)/"; \
	    (cd "$$stage" && zip -qr "$$stage/candidate.zip" "$(WIN_DISTDIR)"); \
	    mv "$$stage/candidate.zip" "$(CURDIR)/$(WIN_DISTNAME).zip"; \
	    echo "Created $(WIN_DISTNAME).zip (standard and English-initial executables)."
