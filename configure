#!/bin/sh
# Lightweight configure script for Rogue DOS Tribute.
# This is not generated by autoconf.  It only writes config.mk for Makefile.

set -u

prefix=/usr/local
exec_prefix='$(prefix)'
datarootdir='$(prefix)/share'
datadir='$(datarootdir)'
bindir='$(exec_prefix)/bin'
mandir='$(datarootdir)/man'
docdir='$(datarootdir)/doc/$(PROGRAM)'
man6dir='$(mandir)/man6'
ja_man_style=auto
ja_man6dirs=

program=rogue
filedir=
savefile=
scorefile=
lockfile=
wizard=0
default_language=auto

CC=${CC:-cc}
CFLAGS=${CFLAGS:-'-g -O2'}
CPPFLAGS=${CPPFLAGS:-}
LDFLAGS=${LDFLAGS:-}
CURSES_CFLAGS=${CURSES_CFLAGS:-}
CURSES_LIBS=${CURSES_LIBS:-}
curses_test=1
host_os=`uname -s 2>/dev/null || echo unknown`

usage() {
    cat <<'USAGE'
Usage: ./configure [OPTIONS]

This source tree uses a checked-in Makefile.  configure is a small helper that
writes config.mk; it does not generate Makefile or config.h.

Options:
  --help                         Show this help
  --prefix=DIR                   Installation prefix [/usr/local]
  --exec-prefix=DIR              Executable prefix [$(prefix)]
  --bindir=DIR                   Executable directory [$(exec_prefix)/bin]
  --mandir=DIR                   Manual root directory [$(datarootdir)/man]
  --man6dir=DIR                  English manual section directory [$(mandir)/man6]
  --ja-man-style=STYLE           Japanese manual dirs: auto, linux, mac, all, none [auto]
  --ja-man6dir=DIR               Japanese manual section directory; overrides --ja-man-style
  --ja-man6dirs=DIRS             Space-separated Japanese manual dirs; overrides --ja-man-style
  --docdir=DIR                   Documentation directory [$(datarootdir)/doc/$(PROGRAM)]
  --program=NAME                 Program name [rogue]
  --file-dir=DIR                 Directory for save, score, and lock files
  --save-file=FILE               Default save file [$(PROGRAM).save or $(FILEDIR)/$(PROGRAM).save]
  --score-file=FILE              Default score file [$(PROGRAM).scr or $(FILEDIR)/$(PROGRAM).scr]
  --lock-file=FILE               Default lock file [$(PROGRAM).lck or $(FILEDIR)/$(PROGRAM).lck]
  --wizard                       Enable wizard mode
  --default-language=LANG       Default language: auto, ja, or en [auto]
  --with-curses-cflags=FLAGS     Override curses compiler flags
  --with-curses-libs=LIBS        Override curses linker flags
  --disable-curses-test          Do not compile-test curses flags

Environment:
  CC, CFLAGS, CPPFLAGS, LDFLAGS, CURSES_CFLAGS, and CURSES_LIBS are honored.

Examples:
  ./configure
  ./configure --program=rdt
  ./configure --prefix=/usr --program=rdt --default-language=ja
  make
USAGE
}

for opt in "$@"; do
    case "$opt" in
        --help|-h) usage; exit 0 ;;
        --prefix=*) prefix=${opt#*=} ;;
        --exec-prefix=*) exec_prefix=${opt#*=} ;;
        --datarootdir=*) datarootdir=${opt#*=} ;;
        --datadir=*) datadir=${opt#*=} ;;
        --bindir=*) bindir=${opt#*=} ;;
        --mandir=*) mandir=${opt#*=} ;;
        --docdir=*) docdir=${opt#*=} ;;
        --man6dir=*) man6dir=${opt#*=} ;;
        --ja-man-style=*) ja_man_style=${opt#*=} ;;
        --ja-man6dir=*) ja_man6dirs=${opt#*=} ;;
        --ja-man6dirs=*) ja_man6dirs=${opt#*=} ;;
        --program=*) program=${opt#*=} ;;
        --file-dir=*) filedir=${opt#*=} ;;
        --save-file=*) savefile=${opt#*=} ;;
        --score-file=*) scorefile=${opt#*=} ;;
        --lock-file=*) lockfile=${opt#*=} ;;
        --wizard) wizard=1 ;;
        --default-language=*) default_language=${opt#*=} ;;
        --with-curses-cflags=*) CURSES_CFLAGS=${opt#*=} ;;
        --with-curses-libs=*) CURSES_LIBS=${opt#*=} ;;
        --disable-curses-test) curses_test=0 ;;
        *) echo "configure: error: unknown option: $opt" >&2; echo "Try './configure --help'." >&2; exit 1 ;;
    esac
done

case "$default_language" in
    auto|ja|en) ;;
    *) echo "configure: error: language must be auto, ja, or en" >&2; exit 1 ;;
esac

case "$ja_man_style" in
    auto|linux|mac|all|none) ;;
    *) echo "configure: error: --ja-man-style must be auto, linux, mac, all, or none" >&2; exit 1 ;;
esac

if [ -z "$ja_man6dirs" ]; then
    case "$ja_man_style" in
        auto)
            case "$host_os" in
                Darwin) ja_man6dirs='$(mandir)/ja_JP.UTF-8/man6 $(mandir)/ja.UTF-8/man6' ;;
                *)      ja_man6dirs='$(mandir)/ja/man6' ;;
            esac
            ;;
        linux) ja_man6dirs='$(mandir)/ja/man6' ;;
        mac)   ja_man6dirs='$(mandir)/ja_JP.UTF-8/man6 $(mandir)/ja.UTF-8/man6' ;;
        all)   ja_man6dirs='$(mandir)/ja/man6 $(mandir)/ja_JP.UTF-8/man6 $(mandir)/ja.UTF-8/man6' ;;
        none)  ja_man6dirs= ;;
    esac
fi

case "$program" in
    ''|*[!/A-Za-z0-9_.-]*|[-.]*)
        echo "configure: error: invalid program name: $program" >&2
        exit 1
        ;;
esac

: > config.log
log() { echo "$*" >> config.log; }
notice() { echo "configure: $*"; log "configure: $*"; }

# Always remove scratch files, including when interrupted during a probe.
cleanup_conftest() {
    rm -f conftest.c conftest conftest.o conftest.exe
}
trap 'cleanup_conftest' 0
trap 'exit 1' 1 2 3 15

cat > conftest.c <<'EOFTEST'
#include <curses.h>
int main(void) { initscr(); endwin(); return 0; }
EOFTEST

try_curses() {
    cf=$1
    libs=$2
    rm -f conftest conftest.o conftest.exe
    log "checking curses flags: $cf $libs"
    # Intentional word splitting is used so flag lists behave like compiler flags.
    # shellcheck disable=SC2086
    $CC $CPPFLAGS $CFLAGS $cf conftest.c $LDFLAGS $libs -o conftest >> config.log 2>&1
}

if [ "$curses_test" -eq 1 ]; then
    if [ -n "$CURSES_LIBS" ] || [ -n "$CURSES_CFLAGS" ]; then
        notice "checking supplied curses flags"
        if ! try_curses "$CURSES_CFLAGS" "$CURSES_LIBS"; then
            echo "configure: error: supplied curses flags do not work" >&2
            echo "See config.log for details." >&2
            rm -f conftest.c conftest conftest.o conftest.exe
            exit 1
        fi
    else
        notice "checking for curses"
        found=0
        if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists ncursesw 2>/dev/null; then
            pc_cflags=`pkg-config --cflags ncursesw 2>/dev/null`
            pc_libs=`pkg-config --libs ncursesw 2>/dev/null`
            if try_curses "$pc_cflags" "$pc_libs"; then
                CURSES_CFLAGS=$pc_cflags
                CURSES_LIBS=$pc_libs
                found=1
            fi
        fi
        if [ "$found" -eq 0 ]; then
            for cfg in ncursesw6-config ncursesw5-config ncursesw-config; do
                if command -v "$cfg" >/dev/null 2>&1; then
                    cf=`$cfg --cflags 2>/dev/null`
                    libs=`$cfg --libs 2>/dev/null`
                    if try_curses "$cf" "$libs"; then
                        CURSES_CFLAGS=$cf
                        CURSES_LIBS=$libs
                        found=1
                        break
                    fi
                fi
            done
        fi
        if [ "$found" -eq 0 ]; then
            case "$host_os" in
                Darwin) candidates='-lcurses -lncursesw -lncurses' ;;
                *)      candidates='-lncursesw -lncurses -lcurses' ;;
            esac
            for libs in $candidates; do
                if try_curses "" "$libs"; then
                    CURSES_CFLAGS=
                    CURSES_LIBS=$libs
                    found=1
                    break
                fi
            done
        fi
        if [ "$found" -eq 0 ]; then
            echo "configure: error: curses/ncursesw development files were not found" >&2
            echo "Install ncurses development headers, or pass --with-curses-libs/--with-curses-cflags." >&2
            echo "See config.log for details." >&2
            rm -f conftest.c conftest conftest.o conftest.exe
            exit 1
        fi
    fi
else
    notice "skipping curses compile test"
    if [ -z "$CURSES_LIBS" ]; then
        case "$host_os" in
            Darwin) CURSES_LIBS='-lcurses' ;;
            *)      CURSES_LIBS='-lncursesw' ;;
        esac
    fi
fi

rm -f conftest.c conftest conftest.o conftest.exe

{
    echo '# config.mk - generated by ./configure'
    echo '# Edit only if you know what you are doing; rerun ./configure to regenerate.'
    echo
    echo "CC = $CC"
    echo "CFLAGS = $CFLAGS"
    echo "CPPFLAGS = $CPPFLAGS"
    echo "LDFLAGS = $LDFLAGS"
    echo "CURSES_CFLAGS = $CURSES_CFLAGS"
    echo "CURSES_LIBS = $CURSES_LIBS"
    echo 'LIBS = $(CURSES_LIBS)'
    echo
    echo "prefix = $prefix"
    echo "exec_prefix = $exec_prefix"
    echo "datarootdir = $datarootdir"
    echo "datadir = $datadir"
    echo "bindir = $bindir"
    echo "mandir = $mandir"
    echo "docdir = $docdir"
    echo "man6dir = $man6dir"
    echo "JAMAN6DIRS = $ja_man6dirs"
    echo
    echo "PROGRAM = $program"
    [ -n "$filedir" ] && echo "FILEDIR = $filedir"
    [ -n "$savefile" ] && echo "SAVEFILE = $savefile"
    [ -n "$scorefile" ] && echo "SCOREFILE = $scorefile"
    [ -n "$lockfile" ] && echo "LOCKFILE = $lockfile"
    echo
    if [ "$wizard" -eq 1 ]; then
        echo 'MASTER = 1'
    fi
    case "$default_language" in
        ja) echo 'DEFAULT_LANGUAGE = 1' ;;
        en) echo 'DEFAULT_LANGUAGE = 2' ;;
    esac
} > config.mk

notice "created config.mk"
notice "program: $program"
if [ -n "$filedir" ]; then
    notice "data file directory: $filedir"
fi
notice "curses libs: $CURSES_LIBS"
notice "option defaults: color, extended characters, nocursor"
if [ -n "$ja_man6dirs" ]; then
    notice "Japanese manual dirs: $ja_man6dirs"
else
    notice "Japanese manual dirs: disabled"
fi
if [ -n "$CURSES_CFLAGS" ]; then
    notice "curses cflags: $CURSES_CFLAGS"
fi
if [ "$wizard" -eq 1 ]; then
    notice "wizard mode: enabled"
fi
case "$default_language" in
    ja) notice "default language: Japanese" ;;
    en) notice "default language: English" ;;
    auto) notice "default language: locale auto-detection" ;;
esac

echo
printf '%s\n' "Now run: make"
